{
  "expo": {
    "name": "MedBook",
    "slug": "medbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#149BFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medbook.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#149BFF"
      },
      "package": "com.medbook.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "medbook",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
